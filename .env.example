# ============================================================================
# Docker Compose
# ============================================================================
COMPOSE_PROJECT_NAME=redisstack
TZ=America/Sao_Paulo

# ============================================================================
# Redis / Valkey
# ----------------------------------------------------------------------------
# Default: Valkey 8 Alpine (BSD, drop-in replacement do Redis, mantido pela
# Linux Foundation). Se preferir Redis 8 oficial (AGPLv3), troque pra:
#   redis:8-alpine
# Clientes (ioredis, node-redis, go-redis, etc) funcionam em ambos sem mudar
# uma linha de código.
# ============================================================================
REDIS_IMAGE=valkey/valkey:8-alpine
REDIS_CONTAINER_NAME=redis

# Senha — OBRIGATÓRIA. Gere com: openssl rand -base64 32
REDIS_PASSWORD="ads"

REDIS_PORT=6379

# Limite máximo de memória que o Redis vai usar.
# Quando atinge, aplica a REDIS_MAXMEMORY_POLICY abaixo.
REDIS_MAXMEMORY=3gb

# Política de eviction quando atinge maxmemory:
#   noeviction       -> rejeita writes (seguro se NÃO for cache)
#   allkeys-lru      -> remove menos usada recentemente (bom pra cache puro)
#   allkeys-lfu      -> remove menos frequentemente usada (melhor p/ workloads hot/cold bem definidos)
#   volatile-lru     -> LRU só em keys com TTL (mistura cache + dados persistentes)
#   volatile-ttl     -> remove as com TTL mais próximo de expirar
#   allkeys-random / volatile-random -> aleatório (raro)
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Log driver
REDIS_LOG_MAX_SIZE=10m
REDIS_LOG_MAX_FILE=3

# ============================================================================
# Backup scheduler
# ============================================================================
BACKUP_CONTAINER_NAME=redis-backup

# Cron schedule — SEMPRE entre aspas por causa dos espaços
BACKUP_SCHEDULE="0 3 * * *"
BACKUP_RETENTION_DAYS=2
BACKUP_ON_START=false
